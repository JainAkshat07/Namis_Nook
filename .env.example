# Sanity connection for the public website (safe to expose — read-only, public dataset)
VITE_SANITY_PROJECT_ID=wymdx6sh
VITE_SANITY_DATASET=production

# Only needed to RUN the one-time migration script (scripts/migrate.mjs).
# Create it at https://www.sanity.io/manage -> your project -> API -> Tokens (Editor/write).
# NEVER commit this. Keep it only in your local .env file.
SANITY_WRITE_TOKEN=
